{
 "framework":"vite", "buildCommand":"npm run build", "outputDirectory":"dist",
 "functions":{"api/bridge.mjs":{"maxDuration":300}},
 "rewrites":[
  {"source":"/deployment.json","destination":"/api/bridge?resource=deployment"},
  {"source":"/api/solana-demo","destination":"/api/bridge?resource=solana"},
  {"source":"/api/pix","destination":"/api/bridge?resource=pix"},
  {"source":"/((?!api/|assets/|sw.js|manifest.webmanifest).*)","destination":"/index.html"}
 ],
 "headers":[{"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache"}] }]
}
