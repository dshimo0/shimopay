EVM_RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=
FX_SIGNER_PRIVATE_KEY=
# Hosted demo only: web and local Hardhat node must run on the same server.
DEMO_HOSTED_MODE=0

# Solana is the default demo rail. Test networks only.
SOLANA_RPC_URL=https://api.devnet.solana.com
SHIMOPAY_SOLANA_KEY_DIR=
# Optional executable overrides for managed environments:
SOLANA_CLI=solana
SOLANA_VALIDATOR=solana-test-validator
SHIMOPAY_PLATFORM_TOOLS=

# Champion path: official Circle testnet USDC. Never mainnet / real funds.
SOLANA_CLUSTER=devnet
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# FX issuer uses a separate ignored .solana/fx-signer.json development key.
# Test provider token only. Server-side; never NEXT_PUBLIC and never committed.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_TEST_PAYER_EMAIL=
# Development demo reserve: 10 USDC when funded with 20 total; use 50 for the full scenario.
SHIMOPAY_RESERVE_USDC=10
# Optional installed native CLI; deploy script discovers bundled Codex Cloud CLI automatically.
# SOLANA_CLI=/workspace/.tooling/agave-2.3/solana-release/bin/solana
